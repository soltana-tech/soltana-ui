name: Release
# Requires NPM_TOKEN repository secret to be configured.
#
# WORKFLOW STATUS: DISABLED
#
# This workflow is currently disabled (via .disabled file extension) because:
# - NPM_TOKEN repository secret is not yet configured
# - Automated NPM publishing requires authentication credentials
#
# To re-enable automated releases:
# 1. Configure NPM_TOKEN repository secret in GitHub Settings
# 2. Rename this file from release.yml.disabled to release.yml
# 3. The workflow will automatically run on the next push to main
#
# Current release procedure:
# - Use `pnpm changeset` to create changesets for changes
# - Changesets are tracked in .changeset/ directory
# - Manual publishing via `pnpm run release` (requires local NPM authentication)

on:
  push:
    branches: [main]

concurrency:
  group: release-${{ github.ref }}
  cancel-in-progress: false

env:
  TURBO_TOKEN: ${{ secrets.TURBO_TOKEN }}
  TURBO_TEAM: ${{ vars.TURBO_TEAM }}

jobs:
  release:
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: write
      pull-requests: write
    outputs:
      publishedPackages: ${{ steps.changesets.outputs.publishedPackages }}

    steps:
      - name: Harden runner
        uses: step-security/harden-runner@1d88384fd173af6ecb012dfd0264a306b711241a # v2.22.4
        with:
          egress-policy: audit

      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - uses: pnpm/action-setup@73e46992e05b19abd31f2f3c20e0e7370d762115 # v6.1.1

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version-file: .node-version
          cache: pnpm
          registry-url: https://registry.npmjs.org

      - run: pnpm install --frozen-lockfile

      - name: Lint
        run: pnpm run lint

      - name: Build
        run: pnpm run build

      - name: Type-check
        run: pnpm run type-check

      - name: Unit tests
        run: pnpm run test

      - name: Install Playwright browsers
        run: pnpm exec playwright install --with-deps
        env:
          PLAYWRIGHT_BROWSERS_PATH: '0'

      - name: Run E2E tests
        run: pnpm run test:e2e

      - name: Create release PR or publish
        id: changesets
        uses: changesets/action@ae32849d5ba541f9ae29e40e22a623bc13562f51 # v2.1.2
        with:
          publish: pnpm run release
          version: pnpm run version-packages
          title: 'chore: version packages'
          commit: 'chore: version packages'
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}
