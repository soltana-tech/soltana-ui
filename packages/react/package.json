{
  "name": "@soltana-ui/react",
  "version": "0.1.1",
  "private": false,
  "description": "React bindings for Soltana UI — useSoltana() hook and SoltanaProvider. ESM-only.",
  "keywords": [
    "react",
    "hooks",
    "soltana-ui",
    "design-system",
    "theme"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Soltana",
  "repository": {
    "type": "git",
    "url": "https://github.com/soltana-tech/soltana-ui.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/soltana-react.js",
  "module": "./dist/soltana-react.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/soltana-react.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "lint": "pnpm run lint:ts",
    "lint:ts": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "31.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "soltana-ui": "workspace:*",
    "vite": "8.3.6",
    "vite-plugin-dts": "5.1.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "soltana-ui": "workspace:^"
  }
}
