{
  "name": "@soltana-ui/tokens",
  "version": "0.2.0",
  "private": false,
  "sideEffects": false,
  "description": "Design token compiler for Soltana UI — outputs Mermaid themes, DTCG JSON, and documentation formats.",
  "keywords": [
    "design-tokens",
    "soltana-ui",
    "design-system",
    "dtcg",
    "css-variables"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Soltana",
  "repository": {
    "type": "git",
    "url": "https://github.com/soltana-tech/soltana-ui.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.ts"
    },
    "./mermaid/*": "./dist/mermaid/*",
    "./dtcg/*": "./dist/dtcg/*",
    "./agents/*": "./dist/agents/*"
  },
  "scripts": {
    "build": "tsx src/build.ts && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "pnpm run lint:ts",
    "lint:ts": "eslint src/",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "js-yaml": "5.5.0",
    "postcss": "8.5.32",
    "soltana-ui": "workspace:*",
    "tsx": "4.23.15",
    "vitest": "5.1.0"
  }
}
