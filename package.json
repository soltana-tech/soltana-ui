{
  "name": "soltana-ui-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium firefox webkit",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:update": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --update-snapshots=changed",
    "test:e2e:visual": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/visual-regression.spec.ts",
    "test:e2e:a11y": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/accessibility.spec.ts",
    "test:e2e:config": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/config/",
    "test:e2e:enhancers": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test tests/enhancers/",
    "test:e2e:full": "PLAYWRIGHT_BROWSERS_PATH=0 FULL_MATRIX=1 playwright test tests/visual-regression.spec.ts",
    "test:a11y-matrix": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --config playwright.a11y-matrix.config.ts",
    "test:all": "turbo run test && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "lint": "turbo run lint",
    "lint:ts": "turbo run lint:ts",
    "lint:style": "turbo run lint:style",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "prepare": "command -v pre-commit >/dev/null 2>&1 && pre-commit install || echo 'pre-commit not installed, skipping hook installation'"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-organize-imports": "4.3.0",
    "stylelint": "17.3.0",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-prettier": "5.1.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "pnpm": {
    "overrides": {
      "ajv@>=8 <9": "8.18.0",
      "lodash": "4.18.1",
      "minimatch@>=7 <11": "11.0.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
